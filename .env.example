# Black Raven Service Desk — Environment Variables
# Copy to .env and fill in actual values
# NEVER commit .env to git

# ============================================================
# DOMAIN & SSL
# ============================================================
ZAMMAD_DOMAIN=support.blackravenit.com
ZAMMAD_FQDN=support.blackravenit.com
SSL_CERT_PATH=./nginx/ssl/fullchain.pem
SSL_KEY_PATH=./nginx/ssl/privkey.pem

# ============================================================
# POSTGRESQL
# ============================================================
POSTGRES_USER=zammad
POSTGRES_PASS=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=zammad_production
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432

# ============================================================
# ELASTICSEARCH
# ============================================================
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_PASS=CHANGE_ME_STRONG_PASSWORD
ELASTICSEARCH_SCHEMA=http
# Set to true in production with proper certs
ELASTICSEARCH_SSL_VERIFY=false

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379

# ============================================================
# ZAMMAD
# ============================================================
ZAMMAD_RAILSSERVER_HOST=zammad-railsserver
ZAMMAD_WEBSOCKET_HOST=zammad-websocket
# Initial admin credentials (change immediately after first login)
ZAMMAD_ADMIN_EMAIL=admin@blackravenit.com
ZAMMAD_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
ZAMMAD_ADMIN_FIRSTNAME=Admin
ZAMMAD_ADMIN_LASTNAME=BlackRaven

# ============================================================
# MICROSOFT OAUTH (Entra ID)
# ============================================================
# Register app at: https://portal.azure.com → App registrations
# Redirect URI: https://${ZAMMAD_DOMAIN}/auth/microsoft_office365/callback
MICROSOFT_APP_ID=CHANGE_ME_AZURE_APP_CLIENT_ID
MICROSOFT_APP_SECRET=CHANGE_ME_AZURE_APP_CLIENT_SECRET
MICROSOFT_TENANT_ID=CHANGE_ME_AZURE_TENANT_ID

# ============================================================
# NINJAONE INTEGRATION
# ============================================================
# Register app at: https://app.ninjarmm.com → Administration → Apps
NINJAONE_CLIENT_ID=CHANGE_ME_NINJA_CLIENT_ID
NINJAONE_CLIENT_SECRET=CHANGE_ME_NINJA_CLIENT_SECRET
NINJAONE_INSTANCE_URL=https://app.ninjarmm.com
# Webhook secret for verifying incoming NinjaOne webhooks
NINJAONE_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ============================================================
# ZAMMAD API (for ninja-bridge)
# ============================================================
ZAMMAD_API_URL=http://zammad-railsserver:3000
ZAMMAD_API_TOKEN=CHANGE_ME_ZAMMAD_API_TOKEN

# ============================================================
# CLAMAV
# ============================================================
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ============================================================
# BACKUP
# ============================================================
BACKUP_RETENTION_DAYS=30
# DigitalOcean Spaces for backup storage
BACKUP_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
BACKUP_S3_BUCKET=blackraven-backups
BACKUP_S3_KEY=CHANGE_ME_SPACES_KEY
BACKUP_S3_SECRET=CHANGE_ME_SPACES_SECRET

# ============================================================
# PATCHING AGENT
# ============================================================
PATCH_CHECK_INTERVAL=daily
PATCH_NOTIFY_EMAIL=admin@blackravenit.com
PATCH_AUTO_STAGE=true
PATCH_AUTO_APPLY=false
